# Safe to source more than once: everything below is idempotent (assignments,
# function defs, PATH prepends). Interactive shells re-source this from .myrc
# so PATH prepends survive macOS's /etc/zprofile → path_helper demotion.

[ -r "$MYRC_DIR/.tokens" ] && . "$MYRC_DIR/.tokens"

for env in "$MYRC_DIR"/.env-*; do
  [ -r "$env" ] && . "$env"
done
unset env

# Make non-interactive bash/dash descendants source this file too, so
# scripts and editor subshells see the tokens + env-manager stubs.
export BASH_ENV="$MYRC_DIR/.myenv"
export ENV="$MYRC_DIR/.myenv"
