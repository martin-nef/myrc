export EDITOR='code --wait'

find-by-port() {
  lsof -n -i :"$1"
}

kill-by-port() {
  local signal=""
  local port=""

  case "$1" in
    -*) signal="$1"; port="$2" ;;
    *)  port="$1" ;;
  esac

  if [ -z "$port" ]; then
    echo "Usage: kill-by-port [-SIGNAL] PORT"
    return 1
  fi

  local pids
  pids=$(lsof -t -i :"$port")

  if [ -z "$pids" ]; then
    echo "No processes found on port $port."
    return 0
  fi

  echo "Killing processes on port $port: $pids"
  echo "$pids" | xargs kill $signal
}


find-in-parallel() {
  local pat=$1
  shift
  parallel -j+0 find '{}' -type f -iname "$pat" ::: "$@"
}

unalias cls &2> /dev/null
unset -f cls
unalias clear &2> /dev/null
unset -f clear
cls() {
  unalias clear &2> /dev/null
  unset -f clear
  clear && clear && clear
}


###############################
#         grep stuff          #
###############################
first-word() {
  awk '{print $1}' "$@"
}

grepp() {
  grep -Eo "$1"
}
