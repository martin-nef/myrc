command -v pyenv >/dev/null || return

# Put shims on PATH eagerly so non-interactive `#!/usr/bin/env python`
# scripts resolve to pyenv instead of system Python.
: "${PYENV_ROOT:=$HOME/.pyenv}"
[ -d "$PYENV_ROOT/shims" ] || case $- in *i*) PYENV_ROOT=$(pyenv root 2>/dev/null) ;; esac
[ -d "${PYENV_ROOT:-}/bin"   ] && export PYENV_ROOT PATH="$PYENV_ROOT/bin:$PATH"
[ -d "${PYENV_ROOT:-}/shims" ] && export PYENV_ROOT PATH="$PYENV_ROOT/shims:$PATH"

case $- in *i*) ;; *) return ;; esac

# `eval "$(pyenv init -)"` forks ~220 ms every shell. Defer until the user
# actually invokes a Python command interactively.
_myrc_pyenv_load() {
  unset -f pyenv python python3 pip pip3 _myrc_pyenv_load 2>/dev/null
  eval "$(pyenv init -)"
}

pyenv()   { _myrc_pyenv_load; pyenv "$@"; }
python()  { _myrc_pyenv_load; python "$@"; }
python3() { _myrc_pyenv_load; python3 "$@"; }
pip()     { _myrc_pyenv_load; pip "$@"; }
pip3()    { _myrc_pyenv_load; pip3 "$@"; }
