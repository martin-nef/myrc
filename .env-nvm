# shellcheck shell=bash disable=SC1091  # nvm.sh path varies per install

# TODO: add support for bash & Ubuntu/Debian install paths

[ "$MYRC_SHELL" = "zsh" ] || return

export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] || return

# Sourcing nvm.sh eagerly costs ~1.5 s because it activates a default node.
# Defer until the user actually invokes nvm/node/npm; then do the full init
# (with `use`), wire up the chpwd hook, and run load-nvmrc once.
_myrc_nvm_load() {
  unset -f nvm node npm npx corepack yarn pnpm _myrc_nvm_load 2>/dev/null

  \. "/opt/homebrew/opt/nvm/nvm.sh"
  [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] &&
    \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

  autoload -U add-zsh-hook
  load-nvmrc() {
    [[ -e .nvmrc ]] || return
    local node_version nvmrc_path
    node_version="$(nvm version)"
    nvmrc_path="$(nvm_find_nvmrc)"

    if [ -n "$nvmrc_path" ]; then
      local nvmrc_node_version
      nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")

      if [ "$nvmrc_node_version" = "N/A" ]; then
        nvm install
      elif [ "$nvmrc_node_version" != "$node_version" ]; then
        nvm use >/dev/null
      fi
    elif [ "$node_version" != "$(nvm version default)" ]; then
      echo "Reverting to nvm default version"
      nvm use default
    fi
  }
  add-zsh-hook chpwd load-nvmrc
  load-nvmrc
}

nvm() {
  _myrc_nvm_load
  nvm "$@"
}
node() {
  _myrc_nvm_load
  node "$@"
}
npm() {
  _myrc_nvm_load
  npm "$@"
}
npx() {
  _myrc_nvm_load
  npx "$@"
}
corepack() {
  _myrc_nvm_load
  corepack "$@"
}
yarn() {
  _myrc_nvm_load
  yarn "$@"
}
pnpm() {
  _myrc_nvm_load
  pnpm "$@"
}
